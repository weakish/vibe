# bar -> psi converter (transpiled to Go, then compiled with `goblin build-exe`)
# psi = bar * 100000 / 6894.757293168
# Goblin reads the bar value from stdin (Go-compiled size baseline).
# Float print uses Go FormatFloat('f', -1); Zig/Lua match that shortest decimal.

import "fs"
import "os"

func bar_to_psi(bar) {
    return bar * 14.503773773022
}

var raw = fs.open("/dev/stdin").read().trim()
if raw == "" {
    print("usage: echo <bar> | bar2psi")
    os.exit(1)
}
try {
    var bar = Float(value=raw)
    var psi = bar_to_psi(bar)
    # Fraction form keeps 90%/75% exact in binary float (0.9 is not).
    var psi_90 = psi * 9 / 10
    var psi_75 = psi * 3 / 4
    print(bar, "bar =", psi, psi_90, psi_75, "psi")
} catch e {
    if e.is(ValueError) {
        print("error: '" + raw + "' is not a number")
        os.exit(1)
    }
    raise e
}
